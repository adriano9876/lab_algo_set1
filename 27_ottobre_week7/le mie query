--9) Trova la traccia più lunga per ogni genere musicale
;with cte_massimo as (
	select g.GenreId,g.GenreName, max(t.Duration) max_durata
	from music.Tracks t join music.Genres g on g.GenreId = t.GenreId
	group by g.GenreId,g.GenreName
)
select t.TrackTitle,c.GenreName, t.Duration durata
from cte_massimo c join music.Tracks t on c.max_durata = t.Duration 
order by Duration desc
 
--10) Trova tutti gli album che contengono tracce di almeno 3 generi diversi

select a.AlbumId,a.AlbumTitle,COUNT (g.GenreId) quantita_generi
from music.Albums a join music.Tracks t on t.AlbumId = a.AlbumId
	join music.Genres g on g.GenreId = t.GenreId
group by a.AlbumId,a.AlbumTitle
having COUNT (g.GenreId)>=3
order by quantita_generi desc
 
--11) Trova il genere musicale con la durata totale maggiore di tutte le sue tracce
select top (1) g.GenreId,g.GenreName,sum(t.Duration) somma
from music.Genres g join music.Tracks t on t.GenreId = g.GenreId 
group by g.GenreId,g.GenreName

 
--12) Trova tutti gli album pubblicati negli anni '90 che hanno almeno una traccia di durata
--superiore a 5 minuti (300000 millisecondi)

select distinct a.AlbumId,a.AlbumTitle
from music.Albums a join music.Tracks t on t.AlbumId= a.AlbumId 
where a.ReleaseYear >= 1990 and a.ReleaseYear <2000 and t.Duration > 300000

 
--13) Trova gli artisti che hanno scritto tracce in esattamente 2 generi diversi
select distinct a.ArtistId,a.ArtistName , COUNT (distinct g.GenreId) quantita_generi
from music.Artists a 
	join music.TrackAuthors ta on ta.ArtistId = a.ArtistId
	join music.Tracks t on t.TrackId = ta.TrackId
	join music.Genres g on g.GenreId = t.GenreId
group by a.ArtistId,a.ArtistName 
having  COUNT (distinct g.GenreId) = 2
 
--14) Trova l'album con il maggior numero di tracce. In caso di parità, mostra quello 
--uscito più recentemente

select  a.AlbumId,a.AlbumTitle, count (t.TrackId) numero_traccie
from music.Albums a join music.Tracks t on t.AlbumId = a.AlbumId
group by a.AlbumId,a.AlbumTitle
order by numero_traccie desc

