--4) Conta quanti album sono stati pubblicati tra il 2015 e il 2020 e hanno un titolo che 
-- inizia per 'A' o 'T'

select count(a.AlbumId) quantita 
from music.Albums a
where a.ReleaseYear>=2015 and a.ReleaseYear<=2020 and (a.AlbumTitle like 'a%' or a.AlbumTitle like 't%' )
 
--5) Trova i primi tre generi musicali con più tracce. In caso di parità, ordina per nome del
--genere in ordine alfabetico
select distinct top(3) g.GenreId,g.GenreName,COUNT(1) quantita
from music.Tracks t join music.Genres g on g.GenreId= t.GenreId 
group by g.GenreId,g.GenreName 
order by quantita desc ;

 
