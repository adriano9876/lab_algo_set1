


--1) Trova tutti gli album usciti prima del 2010
select a.AlbumId, a.AlbumTitle, a.ReleaseYear
from music.Albums a
where a.ReleaseYear < 2010
 
--2) Trova i 5 album con durata complessiva più lunga

select top (5) a.AlbumId, a.AlbumId , sum (t.Duration) as durataSum
from music.Tracks t join music.Albums a on t.AlbumId = a.AlbumId
group by a.AlbumId, a.AlbumId
order by durataSum desc
 
