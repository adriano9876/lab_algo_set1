--trova l'artista che ha lavorato a più generi diversi

select  a.ArtistId,a.ArtistName,g.GenreId,g.GenreName,count (g.GenreId) quanita_generi
from music.Artists a join music.TrackAuthors ta on a.ArtistId = ta.ArtistId
	join music.Tracks t on t.TrackId = ta.TrackId
	join music.Genres g on g.GenreId = t.GenreId
group by a.ArtistId,a.ArtistName,g.GenreId,g.GenreName
order by a.ArtistId,a.ArtistName,g.GenreId,g.GenreName



--trova l'artista che ha scritto più canzoni di uno stesso genere

select  a.ArtistId,a.ArtistName, g.GenreId,count (g.GenreId) quanita_generi
from music.Artists a join music.TrackAuthors ta on a.ArtistId = ta.ArtistId
	join music.Tracks t on t.TrackId = ta.TrackId
	join music.Genres g on g.GenreId = t.GenreId
group by a.ArtistId,a.ArtistName, g.GenreId


