/*  TUTTE LE TRACCE DI CUI TUTTI GLI AUTORI HANNO PUBLICATO 10 O PIU TRACCIE 
se ci sono artitsti che hanno scritto piu traccie anche questi devono avere >10
*/
with cte_artisti_min_10 as (
	select distinct ArtistId as artista_id,COUNT(1) quantita
	from music.TrackAuthors
	group by ArtistId
	having COUNT(1)<10
)
select distinct t.TrackId, t.TrackTitle
from music.Artists a join music.TrackAuthors ta on a.ArtistId = ta.ArtistId 
	join music.Tracks t on ta.TrackId=t.TrackId
where a.ArtistId not in (select artista_id
						from cte_artisti_min_10)




