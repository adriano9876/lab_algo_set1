/*

trova tutte le tracce di album usciti prima del 2000
includi una colonna "Nota" così popolata:
se una traccia è uscita dopo il 1990 scrivi "recente"
se è uscita tra il 1980 e il 1990 (compreso) scrivi "meno recente"
per tutte le altre scrivi "vetusta" 

CASE
WHEN ProductType = 'Electronics' OR ProductType = 'Gadgets' THEN 'Technology'
WHEN ProductType = 'Clothing' OR ProductType = 'Accessories' THEN 'Fashion'
ELSE 'Other'
END */
 select TrackTitle,AlbumTitle,
 case
		when (a.ReleaseYear>1990) then 'recente'
		when (a.ReleaseYear>1980 and a.ReleaseYear <1990 ) then 'meno recente'
		else 'vetusta'
	end as risultato
 from music.Tracks t join music.Albums a on t.AlbumId = a.AlbumId 
 where a.ReleaseYear <=2000
 
/* trova i 5 album con durata complessiva più lunga */  
select  top (5) a.AlbumId ,a.AlbumTitle, sum(t.Duration) durata_album
from music.Albums a join music.Tracks t on a.AlbumId  = t.AlbumId
group by a.AlbumId,a.AlbumTitle
order by durata_album desc

/*trova tutte le tracce con almeno 2 artisti i cui nomi hanno la stessa iniziale */
with cte_n_nomi as(
	select ArtistId ,ArtistName, SUBSTRING(ArtistName, 1, 1) AS ExtractString
	from music.Artists )
select *
from cte_n_nomi c1 join cte_n_nomi c2 on c1.


