/* Seleziona i valori distinti del nome di tutte le persone che 
non hanno gatti, ordina per nome decrescente   */

;with cte_ha_gatti as (
	select distinct p.PersonaId 
	from ang.Persone p 
	join anm.PersoneAnimali pa on p.PersonaId=pa.PersonaId
	join anm.Animali a on a.AnimaleId= pa.AnimaleId 
	join anm.TipoAnimale t on t.TipoAnimaleId= a.TipoAnimaleId
	where  t.TipoAnimale = 'Gatto'
)
select nome,Cognome
from ang.Persone p
where p.PersonaId not in (select PersonaId from cte_ha_gatti)
order by nome desc

