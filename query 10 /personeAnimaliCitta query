 /*Lidia*/
 ;WITH CTE_Gatti AS (
SELECT P.PersonaId
FROM ang.Persone P 
LEFT JOIN anm.PersoneAnimali PA ON P.PersonaId = PA.PersonaId
INNER JOIN anm.Animali A ON PA.AnimaleId = A.AnimaleId
INNER JOIN anm.TipoAnimale TA ON A.TipoAnimaleId = TA.TipoAnimaleId
WHERE TA.TipoAnimale = 'Gatto')
 
SELECT Nome, Cognome
FROM ang.Persone P LEFT JOIN CTE_Gatti G ON P.PersonaId = G.PersonaId
WHERE P.PersonaId NOT IN (SELECT * FROM CTE_Gatti)
ORDER BY P.Nome DESC















